# Names only — never commit values. Copy to .env (gitignored).
#
# .env is where the secret lives. `art30 config set ANTHROPIC_API_KEY <value>`
# writes this file at mode 0600 and never echoes what you gave it.
ANTHROPIC_API_KEY=

# The settings below belong in art30.toml (`art30 config set <key> <value>`,
# docs/settings.md). They are read here too, because a .env is what people
# reach for: a line here beats both settings files and loses to the process
# environment. Put each comment on its own line — everything after the `=`
# is the value, `#` included.
#
# api | claude | codex
ART30_BRAIN=
# the api brain's model id; it is hashed into every request
ART30_MODEL=
# the model each local brain passes to its own CLI
ART30_CLAUDE_MODEL=
ART30_CODEX_MODEL=
# low | medium | high | xhigh | max
ART30_EFFORT=
ART30_MAX_TOKENS=
# turn ceiling for a local brain
ART30_MAX_TURNS=
# tool calls per run; unset, the case kind picks 60 or 120
ART30_TOOL_BUDGET=
# submit_record attempts per run
ART30_SUBMIT_BUDGET=
# dollar ceiling for one api run
ART30_MAX_USD=
# seconds `--approve file` waits for a decision
ART30_GATE_TIMEOUT=
# ask | auto | file
ART30_APPROVE=
# eval cells at once
ART30_CONCURRENCY=
# JSON: {"<model>": [input, output]} dollars per million tokens, for pricing a codex run
ART30_CODEX_PRICES=

# The run switches are not settings and are read from the environment only:
# ART30_MODE, ART30_RECORD, ART30_CACHE_DIR, ART30_TRACE_DIR, ART30_UNLOCK_TEST,
# ART30_REPRODUCIBLE, ART30_WEB_DIR (docs/cli.md), and
# ART30_IGNORE_SETTINGS_FILES=1, which drops art30.toml and ~/.config/art30 for
# one process. The eval harness pins that one on every cell, so no settings file
# of yours can move a sweep.
